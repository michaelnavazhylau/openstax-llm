# Version control
.git/
.github/

# Python & virtual environments
.venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.python-version

# Testing & linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build distributions
dist/
build/
*.egg-info/
*.egg

# Textbook caches & dataset outputs
datasets/
*.jsonl
.scratch_build/
_osbooks/

# Installed agent skills (the source of truth is skills/ in the repository)
.agents/
.claude/
.codex/

# Local environment, secrets & Docker files
# .dockerignore is independent of .gitignore: a secret that is gitignored would otherwise
# still be sent to the builder (and off-machine with a remote driver).
env
*.env
.env
.env.*
!*.env.example
Dockerfile*
.dockerignore
